# ── Email (Phase 1) ──────────────────────────────────────────────────────────
# EMAIL_PROVIDER=none          # none (default, logs to stdout) | smtp | resend | sendgrid
# EMAIL_FROM=noreply@usetether.ca
# EMAIL_FROM_NAME=Tether
# APP_URL=https://usetether.ca  # used in email links

# SMTP (works with Gmail, Office 365, Mailgun SMTP, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_TLS=true                 # true=STARTTLS | ssl=SSL | false=plain

# Resend
# RESEND_API_KEY=re_xxx

# SendGrid
# SENDGRID_API_KEY=SG.xxx

# ── Deployment mode ───────────────────────────────────────────────────────────
# "selfhosted" = no limits, no billing UI (default)
# "saas"       = tier limits enforced, billing UI shown
DEPLOYMENT_MODE=selfhosted

# ── Core ──────────────────────────────────────────────────────────────────────
# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-to-a-long-random-string

# Base domain for subdomain routing. e.g. acme → acme.usetether.ca
# DNS: point *.usetether.ca AND usetether.ca to your server IP.
BASE_DOMAIN=usetether.ca

# Shared rate-limit store (recommended for multi-worker / multi-instance)
# Defaults to local Docker redis service in docker-compose.
# RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# ── Database (MariaDB recommended, SQLite fallback) ───────────────────────────
# Option A — individual vars (used by docker-compose automatically)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tether
DB_USER=tether
DB_PASSWORD=tether

# Option B — explicit connection string (overrides individual vars above)
# DATABASE_URL=mysql+pymysql://tether:tether@localhost:3306/tether?charset=utf8mb4
#
# PostgreSQL (psycopg2 driver included — no extra install needed):
# DATABASE_URL=postgresql://tether:tether@localhost:5432/tether
# AWS Aurora (MySQL-compatible — works with pymysql driver automatically):
# DATABASE_URL=mysql+pymysql://tether:tether@aurora-cluster.rds.amazonaws.com/tether?charset=utf8mb4
#
# SQLite (zero-config fallback — used automatically if DB_HOST is not set):
# DATABASE_URL=sqlite:///./data/tether.db

# MariaDB root password (Docker only)
DB_ROOT_PASSWORD=changeme

# ── MSP admin account (created on first run only) ─────────────────────────────
ADMIN_EMAIL=admin@usetether.ca
ADMIN_PASSWORD=admin
ADMIN_NAME=MSP Admin

# ── Default demo tenant (created on first run only) ───────────────────────────
DEFAULT_TENANT_SLUG=demo
DEFAULT_TENANT_NAME=Demo Client

# Demo reset credentials (optional)
# If omitted, demo router derives strong stable values from RESET_SECRET.
# DEMO_MSP_PASSWORD=
# DEMO_CLIENT_PASSWORD=

# ── Stripe (Phase 2) ──────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_...          # or sk_test_... for testing
# STRIPE_PUBLISHABLE_KEY=pk_live_...     # sent to frontend
# STRIPE_WEBHOOK_SECRET=whsec_...        # from Stripe webhook dashboard

# Create products in Stripe dashboard, then paste their Price IDs here:
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STARTER_ANNUAL=price_...
# STRIPE_PRICE_GROWTH_MONTHLY=price_...
# STRIPE_PRICE_GROWTH_ANNUAL=price_...
# STRIPE_PRICE_SCALE_MONTHLY=price_...
# STRIPE_PRICE_SCALE_ANNUAL=price_...
# Enterprise is handled manually (contact sales)

# ── Backup (Phase 3) ──────────────────────────────────────────────────────────
# BACKUP_ENABLED=false             # true to enable automated backups
# BACKUP_INTERVAL_HOURS=24        # how often to run (default: 24)
# BACKUP_RETAIN_DAYS=30           # delete backups older than N days

# S3-compatible destination (works with AWS S3, Backblaze B2, Cloudflare R2,
# DigitalOcean Spaces, Wasabi, MinIO, or any S3-compatible provider)
# BACKUP_S3_BUCKET=tether-backups
# BACKUP_S3_ACCESS_KEY=your-access-key
# BACKUP_S3_SECRET_KEY=your-secret-key
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_PREFIX=backups/
# BACKUP_S3_ENDPOINT=              # blank = AWS S3
#                                  # Backblaze B2: https://s3.us-west-004.backblazeb2.com
#                                  # Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
#                                  # DigitalOcean:  https://nyc3.digitaloceanspaces.com

# ── Warranty alerts (Phase 3) ─────────────────────────────────────────────────
# WARRANTY_ALERTS_ENABLED=true    # daily at 08:00 UTC (requires EMAIL_PROVIDER set)
# WARRANTY_ALERT_DAYS=30          # warn N days before expiry
