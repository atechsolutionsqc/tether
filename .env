# ── Tether Demo Instance ─────────────────────────────────────────
# Copy this to .env on your demo server, then: docker compose up -d
#
# This runs a separate Tether instance on port 8001 with demo mode
# enabled. The Cloudflare Worker resets the database every hour.

DEPLOYMENT_MODE=demo

# Generate a strong secret and also set it in the Cloudflare Worker:
#   wrangler secret put RESET_SECRET
RESET_SECRET=change-this-to-a-long-random-string

SECRET_KEY=change-this-too-long-random-string

# The demo subdomain — must match your Cloudflare Worker route
BASE_DOMAIN=demo.usetether.ca

# Demo MSP admin (re-created on every reset)
ADMIN_EMAIL=demo-msp@usetether.ca
ADMIN_PASSWORD=demo1234
ADMIN_NAME=Demo MSP Admin

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=tether_demo
DB_USER=tether_demo
DB_PASSWORD=tether_demo
DB_ROOT_PASSWORD=changeme_root
